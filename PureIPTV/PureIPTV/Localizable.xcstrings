        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 받은 에피소드 번호만 확인합니다. 제공업체 데이터가 부정확할 수 있으며 기기 간 비교는 하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert alleen de afleveringsnummering op dit apparaat. Providergegevens kunnen onnauwkeurig zijn; apparaten worden niet vergeleken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza numerację odcinków tylko na tym urządzeniu. Dane dostawcy mogą być niedokładne; urządzenia nie są porównywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica a numeração dos episódios somente neste dispositivo. Os dados do provedor podem estar incorretos; os dispositivos não são comparados."
          }
