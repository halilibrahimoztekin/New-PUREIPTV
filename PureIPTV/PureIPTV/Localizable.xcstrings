          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 소스를 선택하면 목록을 열지 않고 재생목록 순서의 첫 번째 일치 항목을 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
