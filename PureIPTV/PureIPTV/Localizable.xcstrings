    "iCloud eşitleme alanı sınırına ulaşıldı. Bu takip değişikliği eşitlenmedi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم بلوغ حد مساحة مزامنة iCloud. لم تتم مزامنة تغيير المتابعة هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iCloud-Speicherlimit für die Synchronisierung ist erreicht. Diese Änderung der Verfolgung wurde nicht synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud sync storage limit was reached. This follow change was not synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de almacenamiento de iCloud para la sincronización. Este cambio de seguimiento no se sincronizó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de stockage iCloud pour la synchronisation est atteinte. Ce changement de suivi n’a pas été synchronisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud सिंक स्टोरेज सीमा पूरी हो गई। फ़ॉलो करने का यह बदलाव सिंक नहीं हुआ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas penyimpanan sinkronisasi iCloud tercapai. Perubahan ikuti ini tidak disinkronkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato raggiunto il limite di spazio di iCloud per la sincronizzazione. Questa modifica al seguito non è stata sincronizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudの同期ストレージ上限に達しました。このフォロー変更は同期されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화 저장 공간 한도에 도달했습니다. 이 팔로우 변경 사항은 동기화되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iCloud-opslaglimiet voor synchronisatie is bereikt. Deze volgwijziging is niet gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto limit miejsca iCloud na synchronizację. Ta zmiana obserwowania nie została zsynchronizowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de armazenamento do iCloud para sincronização foi atingido. Esta alteração de acompanhamento não foi sincronizada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de armazenamento do iCloud para sincronização foi atingido. Esta alteração de seguimento não foi sincronizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит хранилища iCloud для синхронизации. Это изменение подписки не синхронизировано."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gränsen för iCloud-lagring för synkronisering har nåtts. Den här följändringen synkroniserades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่จัดเก็บสำหรับการซิงก์ iCloud ถึงขีดจำกัดแล้ว การเปลี่ยนแปลงการติดตามนี้ไม่ได้ซิงก์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud eşitleme alanı sınırına ulaşıldı. Bu takip değişikliği eşitlenmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досягнуто ліміт сховища iCloud для синхронізації. Цю зміну відстеження не синхронізовано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đạt giới hạn dung lượng đồng bộ iCloud. Thay đổi theo dõi này chưa được đồng bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到 iCloud 同步存储上限。此关注更改未同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達 iCloud 同步儲存空間上限。此追蹤變更未同步。"
          }
        }
      }
    },
