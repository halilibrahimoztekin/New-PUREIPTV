    "tvOS ekran yöneticisine ulaşılamadı; sistem tercihiniz değiştirilmedi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الوصول إلى مدير شاشة tvOS؛ لم يتغير تفضيل النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der tvOS-Anzeigemanager ist nicht erreichbar; die Systemeinstellung blieb unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tvOS display manager is unavailable; your system preference was not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo acceder al administrador de pantalla de tvOS; no se cambió la preferencia del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gestionnaire d’affichage de tvOS est inaccessible ; la préférence système n’a pas changé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS डिस्प्ले मैनेजर उपलब्ध नहीं है; सिस्टम प्राथमिकता नहीं बदली गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengelola layar tvOS tidak tersedia; preferensi sistem tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gestore schermo di tvOS non è disponibile; la preferenza di sistema non è stata modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOSのディスプレイマネージャにアクセスできません。システム設定は変更していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS 디스플레이 관리자를 사용할 수 없습니다. 시스템 설정은 변경하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tvOS-schermbeheerder is niet beschikbaar; je systeemvoorkeur is niet gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menedżer ekranu tvOS jest niedostępny; preferencje systemowe nie zostały zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gerenciador de tela do tvOS está indisponível; a preferência do sistema não foi alterada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gestor de ecrã do tvOS está indisponível; a preferência do sistema não foi alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менеджер экрана tvOS недоступен; системные настройки не изменены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS skärmhanterare är inte tillgänglig; systeminställningen ändrades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถใช้ตัวจัดการการแสดงผลของ tvOS ได้ และไม่ได้เปลี่ยนการตั้งค่าระบบ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менеджер екрана tvOS недоступний; системні налаштування не змінено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình quản lý màn hình tvOS không khả dụng; tùy chọn hệ thống không bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
