    "Catch-up sırasında geri ve ileri düğmeleri seçilen aralık kadar atlar. Canlı TV ve VOD atlamaları değişmez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم هذا الفاصل عند التخطي للخلف أو للأمام أثناء مشاهدة البث المؤجل. لا يغيّر سلوك التخطي للبث المباشر أو الفيديو حسب الطلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Intervall gilt für die Rückwärts- und Vorwärtstasten bei Catch-up. Sprünge bei Live-TV und VOD bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the step used by the backward and forward buttons during catch-up playback. Live TV and VOD skip behavior stays the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el salto de los botones de avance y retroceso durante la reproducción de catch-up. No cambia los saltos de TV en directo ni de VOD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit le pas des boutons avant et arrière pendant le rattrapage. Les sauts en direct et en VOD restent inchangés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैच-अप प्लेबैक में आगे और पीछे के बटनों का अंतर तय करता है। लाइव टीवी और VOD पर इसका असर नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur lompatan tombol maju dan mundur saat memutar catch-up. Perilaku untuk TV langsung dan VOD tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta l'intervallo dei pulsanti avanti e indietro durante la riproduzione catch-up. I salti per la TV in diretta e i VOD non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見逃し配信中に前後ボタンで移動する間隔を設定します。ライブ TV と VOD のスキップ動作は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 보기 재생 중 앞뒤 이동 버튼의 간격을 설정합니다. 실시간 TV와 VOD의 건너뛰기 동작은 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de stapgrootte van de terug- en vooruitknoppen tijdens terugkijken. Live-tv en VOD blijven hetzelfde werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia skok przycisków przewijania podczas catch-up. Nie zmienia przewijania telewizji na żywo ani VOD."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o intervalo dos botões de avançar e voltar durante a reprodução de catch-up. Os saltos de TV ao vivo e VOD não mudam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o intervalo dos botões de avanço e recuo durante a reprodução em diferido. Os saltos de TV em direto e VOD não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задает шаг кнопок перемотки при просмотре архива. Перемотка прямого эфира и VOD не меняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in hoppet för bakåt- och framåtknapparna vid catch-up. Hopp för direktsänd TV och VOD ändras inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดช่วงการข้ามด้วยปุ่มย้อนกลับและไปข้างหน้าขณะเล่นรายการย้อนหลัง โดยไม่เปลี่ยนการข้ามของทีวีสดและ VOD"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catch-up sırasında geri ve ileri düğmeleri seçilen aralık kadar atlar. Canlı TV ve VOD atlamaları değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визначає крок кнопок перемотування під час перегляду архіву. Перемотування прямого ефіру та VOD не змінюється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt khoảng tua bằng nút tiến và lùi khi xem chương trình phát lại. Cách tua truyền hình trực tiếp và VOD không thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置回看播放时后退和前进按钮的跳转间隔。不会改变直播电视和 VOD 的跳转行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定回看播放時後退和前進按鈕的跳轉間隔。不會改變直播電視和 VOD 的跳轉行為。"
          }
        }
      }
    },
