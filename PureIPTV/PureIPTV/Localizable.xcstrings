    "Bu oyuncunun kataloğunda eşleşen içerik bulunamadı." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر عناوين مطابقة لهذا الممثل في قائمة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Schauspieler sind keine passenden Titel in deiner Playlist verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No matching titles for this actor are available in your playlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay títulos de este actor en tu lista de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun titre correspondant à cet acteur n’est disponible dans votre playlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्लेलिस्ट में इस अभिनेता के लिए कोई मेल खाता शीर्षक उपलब्ध नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada judul yang cocok untuk aktor ini di playlist Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella tua playlist non sono disponibili titoli corrispondenti a questo attore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストにこの俳優の該当作品はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록에서 이 배우와 일치하는 작품을 찾을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn geen overeenkomende titels van deze acteur beschikbaar in je afspeellijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Twojej playliście nie ma pasujących tytułów z tym aktorem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há títulos deste ator disponíveis na sua playlist."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existem títulos deste ator disponíveis na sua playlist."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашем плейлисте нет подходящих работ этого актёра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inga matchande titlar med den här skådespelaren i din spellista."
          }
