    "Alternatif kaynaklar seçildiğinde listeyi açmadan playlist sırasındaki ilk eşleşmeyi oynatır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اختيار المصادر البديلة، يشغّل أول تطابق في ترتيب قائمة التشغيل دون فتح القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
