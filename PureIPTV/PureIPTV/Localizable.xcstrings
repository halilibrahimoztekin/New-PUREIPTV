    "Alternatif kaynaklar seçildiğinde listeyi açmadan playlist sırasındaki ilk eşleşmeyi oynatır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اختيار المصادر البديلة، يشغّل أول تطابق في ترتيب قائمة التشغيل دون فتح القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Auswahl alternativer Quellen wird der erste Treffer in Playlist-Reihenfolge ohne Liste abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When alternatives are selected, play the first playlist match without opening the list."
