    "Anahtar cihazın Keychain’inde tutulur ve iCloud eşitlemesine eklenmez. Doğrulama yalnızca düğmeye dokunduğunuzda yapılır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ على هذا الجهاز في سلسلة المفاتيح. لا تتم مزامنته مع iCloud. يبدأ التحقق فقط عند الضغط على الزر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät im Schlüsselbund gespeichert. Keine iCloud-Synchronisierung. Die Prüfung beginnt erst nach Tippen auf die Schaltfläche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored on this device in Keychain. It is not synced with iCloud. Validation starts only when you tap the button."
