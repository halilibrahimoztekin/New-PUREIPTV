    "Vurgu rengini tvOS atmosferik arka plan tonuyla eşleştirir." : {
      "localizations" : {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوائم لون التمييز مع درجة لونية جوية خفيفة لخلفية tvOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmt die Akzentfarbe auf einen dezenten atmosphärischen tvOS-Hintergrundton ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairs the accent color with a subtle atmospheric tvOS background tint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina el color de acento con un tono atmosférico sutil para el fondo de tvOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe la couleur d’accent à une teinte atmosphérique subtile pour l’arrière-plan tvOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेंट रंग को tvOS की हल्की वातावरणीय बैकग्राउंड टोन से जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadukan warna aksen dengan rona latar atmosferik tvOS yang lembut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina il colore di accento a una delicata tonalità atmosferica dello sfondo tvOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセントカラーをtvOSの背景に控えめな雰囲気の色として反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 색상을 tvOS 배경의 은은한 분위기 색상과 조화시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemt de accentkleur af op een subtiele, sfeervolle tint voor de tvOS-achtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowuje kolor akcentu do subtelnego, nastrojowego odcienia tła tvOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina a cor de destaque com um tom atmosférico sutil no fundo do tvOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina a cor de destaque com um tom atmosférico subtil no fundo do tvOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетает акцентный цвет с лёгким атмосферным оттенком фона tvOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matchar accentfärgen med en diskret stämningsfull nyans i tvOS-bakgrunden."
