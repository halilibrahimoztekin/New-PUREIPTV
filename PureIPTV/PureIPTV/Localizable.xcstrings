        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह केवल इस डिवाइस पर एपिसोड नंबरिंग जाँचता है। प्रदाता का डेटा गलत हो सकता है; डिवाइसों की तुलना नहीं होती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
