    "Gruplar yalnızca seçili profil ve playlist için kaydedilir. Kanallar seçilen playlist kategorilerinden oluşturulur." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المجموعات لهذا الملف الشخصي وقائمة التشغيل فقط. وتُستخرج القنوات من فئات قائمة التشغيل المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen werden nur für das ausgewählte Profil und die Playlist gespeichert. Kanäle stammen aus den gewählten Playlist-Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups are saved only for the selected profile and playlist. Channels come from the selected playlist categories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos solo se guardan para el perfil y la lista seleccionados. Los canales proceden de las categorías elegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes sont enregistrés uniquement pour le profil et la playlist sélectionnés. Les chaînes proviennent des catégories choisies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह केवल चुनी गई प्रोफ़ाइल और प्लेलिस्ट के लिए सहेजे जाते हैं। चैनल चुनी गई प्लेलिस्ट श्रेणियों से आते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup hanya disimpan untuk profil dan daftar putar yang dipilih. Kanal berasal dari kategori daftar putar pilihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi vengono salvati solo per il profilo e la playlist selezionati. I canali provengono dalle categorie scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは選択したプロフィールとプレイリストにのみ保存されます。チャンネルは選択したカテゴリから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 선택한 프로필과 재생목록에만 저장됩니다. 채널은 선택한 재생목록 카테고리에서 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groepen worden alleen opgeslagen voor het geselecteerde profiel en de playlist. Kanalen komen uit de gekozen categorieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupy są zapisywane tylko dla wybranego profilu i playlisty. Kanały pochodzą z wybranych kategorii playlisty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos são salvos apenas para o perfil e a playlist selecionados. Os canais vêm das categorias escolhidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos são guardados apenas para o perfil e a lista selecionados. Os canais vêm das categorias escolhidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы сохраняются только для выбранного профиля и плейлиста. Каналы берутся из выбранных категорий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupper sparas bara för den valda profilen och spellistan. Kanaler hämtas från valda kategorier."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลุ่มจะบันทึกเฉพาะโปรไฟล์และเพลย์ลิสต์ที่เลือก ช่องจะมาจากหมวดหมู่ที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruplar yalnızca seçili profil ve playlist için kaydedilir. Kanallar seçilen playlist kategorilerinden oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групи зберігаються лише для вибраного профілю та списку. Канали беруться з вибраних категорій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm chỉ được lưu cho hồ sơ và danh sách phát đã chọn. Kênh lấy từ các danh mục đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组仅保存到当前所选配置文件和播放列表。频道来自所选播放列表分类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組只會儲存於目前選取的個人檔案和播放清單。頻道取自所選分類。"
          }
        }
      }
    },
