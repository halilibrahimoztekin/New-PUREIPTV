    "Kanal adlarına göre güven skorlu XMLTV eşleşmeleri önerir; siz onaylamadan hiçbir eşleme kaydedilmez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقترح مطابقات XMLTV بدرجات ثقة استنادًا إلى أسماء القنوات؛ ولا يُحفظ أي تطابق قبل تأكيدك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt XMLTV-Zuordnungen mit Konfidenzwert anhand der Sendernamen vor. Gespeichert wird erst nach deiner Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests confidence-scored XMLTV matches by channel name. Nothing is saved until you confirm it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugiere coincidencias XMLTV con una puntuación de confianza según el nombre del canal. No se guarda nada hasta que lo confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose des correspondances XMLTV avec un score de confiance selon le nom de la chaîne. Rien n’est enregistré avant votre confirmation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल नाम के आधार पर विश्वास स्कोर वाले XMLTV मिलान सुझाता है। आपकी पुष्टि के बिना कुछ भी सहेजा नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyarankan kecocokan XMLTV berskor keyakinan berdasarkan nama kanal. Tidak ada yang disimpan sebelum Anda mengonfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerisce corrispondenze XMLTV con un punteggio di affidabilità in base al nome del canale. Nulla viene salvato senza conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネル名から信頼度付きのXMLTV候補を提案します。確認するまで一致項目は保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널 이름을 기준으로 신뢰도 점수가 포함된 XMLTV 일치 항목을 제안합니다. 확인하기 전에는 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt XMLTV-koppelingen met een betrouwbaarheidsscore voor op basis van de kanaalnaam. Er wordt niets opgeslagen zonder bevestiging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponuje dopasowania XMLTV z oceną pewności na podstawie nazw kanałów. Nic nie zostanie zapisane bez potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugere correspondências XMLTV com nível de confiança pelo nome do canal. Nada é salvo até você confirmar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugere correspondências XMLTV com nível de confiança pelo nome do canal. Nada é guardado até confirmar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагает варианты XMLTV с оценкой уверенности по названию канала. Без подтверждения ничего не сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föreslår XMLTV-matchningar med konfidenspoäng utifrån kanalnamn. Inget sparas innan du bekräftar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนะนำรายการ XMLTV พร้อมคะแนนความเชื่อมั่นจากชื่อช่อง โดยจะไม่บันทึกจนกว่าคุณจะยืนยัน"
