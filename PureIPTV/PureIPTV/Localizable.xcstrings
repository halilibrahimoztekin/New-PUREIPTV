    "AVPlayer bu yayın için ekran ölçütü vermedi; sistem tercihiniz değiştirilmedi." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يوفر AVPlayer معايير عرض لهذا البث؛ لم يتغير تفضيل النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer lieferte keine Anzeigekriterien; die Systemeinstellung blieb unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer provided no display criteria for this stream; your system preference was not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer no proporcionó criterios de pantalla; no se cambió la preferencia del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer n’a fourni aucun critère d’affichage ; la préférence système n’a pas changé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer ने इस स्ट्रीम के लिए डिस्प्ले मानदंड नहीं दिए; सिस्टम प्राथमिकता नहीं बदली गई।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer tidak memberikan kriteria layar; preferensi sistem tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer non ha fornito criteri di visualizzazione; la preferenza di sistema non è stata modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayerからこの配信の画面条件を取得できませんでした。システム設定は変更していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer가 이 스트림의 화면 기준을 제공하지 않았습니다. 시스템 설정은 변경하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer leverde geen schermcriteria; je systeemvoorkeur is niet gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer nie podał kryteriów obrazu; preferencje systemowe nie zostały zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer não forneceu critérios de tela; a preferência do sistema não foi alterada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer não forneceu critérios de ecrã; a preferência do sistema não foi alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer не предоставил параметры экрана; системные настройки не изменены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer gav inga skärmkriterier; systeminställningen ändrades inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer ไม่ได้ให้เกณฑ์การแสดงผล และไม่ได้เปลี่ยนการตั้งค่าระบบ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer не надав критеріїв екрана; системні налаштування не змінено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer không cung cấp tiêu chí màn hình; tùy chọn hệ thống không bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
