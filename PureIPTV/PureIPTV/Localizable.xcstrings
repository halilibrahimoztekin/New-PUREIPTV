    "tvOS kare hızı ve dinamik aralığı birlikte eşler. Her iki uygulama seçeneğini de açın." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطابق tvOS معدل الإطارات والنطاق الديناميكي معًا. فعّل خياري التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS passt Bildrate und Dynamikbereich gemeinsam an. Aktiviere beide App-Optionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS matches frame rate and dynamic range together. Turn on both app options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS ajusta juntos la frecuencia de fotogramas y el rango dinámico. Activa ambas opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS adapte ensemble la fréquence d’images et la plage dynamique. Activez les deux options."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS फ्रेम दर और डायनामिक रेंज को साथ मिलाता है। ऐप के दोनों विकल्प चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS mencocokkan laju bingkai dan rentang dinamis sekaligus. Aktifkan kedua opsi aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS abbina insieme frequenza fotogrammi e gamma dinamica. Attiva entrambe le opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOSはフレームレートとダイナミックレンジを同時に合わせます。アプリの両方の設定をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS는 프레임률과 다이내믹 레인지를 함께 맞춥니다. 앱 옵션을 모두 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS stemt beeldsnelheid en dynamisch bereik samen af. Schakel beide app-opties in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS dopasowuje jednocześnie liczbę klatek i zakres dynamiczny. Włącz obie opcje aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tvOS ajusta taxa de quadros e faixa dinâmica em conjunto. Ative as duas opções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tvOS ajusta em conjunto a frequência de fotogramas e a gama dinâmica. Ative ambas as opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS одновременно сопоставляет частоту кадров и динамический диапазон. Включите оба параметра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS matchar bildfrekvens och dynamiskt omfång tillsammans. Aktivera båda appalternativen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS จับคู่อัตราเฟรมและช่วงไดนามิกพร้อมกัน โปรดเปิดตัวเลือกทั้งสองรายการ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS узгоджує частоту кадрів і динамічний діапазон разом. Увімкніть обидва параметри."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS khớp tốc độ khung hình và dải động cùng lúc. Hãy bật cả hai tùy chọn ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS 会同时匹配帧率和动态范围。请开启应用中的两个选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvOS 會同時配對影格率和動態範圍。請開啟 App 中的兩個選項。"
          }
        }
      }
    },
    "tvOS'e ekran eşleme isteği gönderildi. Gerçek geçişi tvOS ve TV belirler." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُرسل طلب مطابقة الشاشة إلى tvOS. يحدد tvOS والتلفاز التبديل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirmanpassung wurde an tvOS gesendet. tvOS und dein Fernseher entscheiden über den Wechsel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display match request sent to tvOS. tvOS and your TV decide whether to switch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envió a tvOS la solicitud de ajuste de pantalla. tvOS y el televisor deciden si cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande d’adaptation de l’écran a été envoyée à tvOS. tvOS et le téléviseur décident du changement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले मिलान का अनुरोध tvOS को भेजा गया। बदलाव tvOS और आपका टीवी तय करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan pencocokan layar dikirim ke tvOS. tvOS dan TV menentukan apakah mode berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta di corrispondenza schermo inviata a tvOS. tvOS e la TV decidono se cambiare modalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面マッチングの要求をtvOSに送信しました。切り替えはtvOSとテレビが決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 매칭 요청을 tvOS로 보냈습니다. 전환 여부는 tvOS와 TV가 결정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoek voor schermmatching naar tvOS verzonden. tvOS en je tv bepalen of er wordt geschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłano do tvOS prośbę o dopasowanie obrazu. tvOS i telewizor zdecydują o przełączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitação de ajuste de tela enviada ao tvOS. O tvOS e a TV decidem se haverá troca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido de correspondência do ecrã enviado ao tvOS. O tvOS e o televisor decidem a mudança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос сопоставления экрана отправлен в tvOS. Переключение решают tvOS и телевизор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begäran om skärmanpassning skickades till tvOS. tvOS och din TV avgör om läget ändras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งคำขอจับคู่การแสดงผลไปยัง tvOS แล้ว โดย tvOS และทีวีจะตัดสินใจเปลี่ยนโหมด"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запит на узгодження екрана надіслано до tvOS. Перемикання визначають tvOS і телевізор."
          }
        },
        "vi" : {
