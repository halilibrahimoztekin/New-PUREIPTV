    "İzlemek için seçin. Takım veya tanınan turnuva takibi için basılı tutun." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر للمشاهدة. اضغط مطولاً لمتابعة فريق أو بطولة معروفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Ansehen auswählen. Gedrückt halten, um einem Team oder erkannten Wettbewerb zu folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select to watch. Touch and hold to follow a team or recognized competition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona para ver. Mantén pulsado para seguir a un equipo o una competición reconocida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez pour regarder. Maintenez appuyé pour suivre une équipe ou une compétition reconnue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखने के लिए चुनें। किसी टीम या पहचानी गई प्रतियोगिता को फ़ॉलो करने के लिए दबाकर रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih untuk menonton. Tekan lama untuk mengikuti tim atau kompetisi yang dikenali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona per guardare. Tieni premuto per seguire una squadra o una competizione riconosciuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択して視聴します。チームまたは認識された大会をフォローするには長押しします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하면 시청합니다. 팀 또는 인식된 대회를 팔로우하려면 길게 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer om te kijken. Houd ingedrukt om een team of herkende competitie te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, aby oglądać. Przytrzymaj, aby obserwować drużynę lub rozpoznane rozgrywki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione para assistir. Mantenha pressionado para seguir um time ou competição reconhecida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione para ver. Mantenha premido para seguir uma equipa ou competição reconhecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, чтобы смотреть. Нажмите и удерживайте, чтобы следить за командой или распознанным соревнованием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj för att titta. Håll ned för att följa ett lag eller en identifierad tävling."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเพื่อรับชม แตะค้างไว้เพื่อติดตามทีมหรือการแข่งขันที่รู้จัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemek için seçin. Takım veya tanınan turnuva takibi için basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть для перегляду. Натисніть і утримуйте, щоб стежити за командою або розпізнаним змаганням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn để xem. Chạm và giữ để theo dõi một đội hoặc giải đấu được nhận diện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择即可观看。按住可关注球队或已识别的赛事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取即可觀看。按住可追蹤球隊或已識別的賽事。"
          }
        }
      }
    },
    "İzlemek için seçin. Takım veya turnuvayı takip etmek için Siri Remote üzerinde Seç düğmesini basılı tutun." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر للمشاهدة. اضغط مطولاً على زر Select في Siri Remote لمتابعة فريق أو بطولة."
