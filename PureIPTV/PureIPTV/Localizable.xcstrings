    "Canlı TV, filmler ve diziler için ayrı playlist seçin. Kaynak kilitliyse veya bulunamıyorsa etkin playlist kullanılır." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قائمة تشغيل منفصلة للبث التلفزيوني والأفلام والمسلسلات. إذا كان المصدر مقفلاً أو غير متاح، فستُستخدم قائمة التشغيل النشطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für Live-TV, Filme und Serien jeweils eine Playlist. Ist die Quelle gesperrt oder nicht verfügbar, wird die aktive Playlist verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose separate playlists for Live TV, movies, and series. If a source is locked or unavailable, the active playlist is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una lista distinta para TV en directo, películas y series. Si una fuente está bloqueada o no está disponible, se usa la lista activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une playlist distincte pour la TV en direct, les films et les séries. Si une source est verrouillée ou indisponible, la playlist active est utilisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव टीवी, फ़िल्मों और सीरीज़ के लिए अलग-अलग प्लेलिस्ट चुनें। स्रोत लॉक या अनुपलब्ध होने पर सक्रिय प्लेलिस्ट इस्तेमाल होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih playlist terpisah untuk TV Live, film, dan serial. Jika sumber terkunci atau tidak tersedia, playlist aktif akan digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli playlist separate per TV in diretta, film e serie. Se una fonte è bloccata o non disponibile, viene usata la playlist attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブTV、映画、シリーズごとに別のプレイリストを選択できます。ソースがロック中または利用できない場合は、アクティブなプレイリストを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 TV, 영화, 시리즈에 각각 다른 재생목록을 선택할 수 있습니다. 소스가 잠겨 있거나 사용할 수 없으면 활성 재생목록을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies aparte afspeellijsten voor Live-tv, films en series. Als een bron is vergrendeld of niet beschikbaar is, wordt de actieve afspeellijst gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz osobne playlisty dla telewizji na żywo, filmów i seriali. Jeśli źródło jest zablokowane lub niedostępne, używana jest aktywna playlista."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha playlists separadas para TV ao vivo, filmes e séries. Se uma fonte estiver bloqueada ou indisponível, a playlist ativa será usada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha listas de reprodução separadas para TV em direto, filmes e séries. Se uma fonte estiver bloqueada ou indisponível, é usada a lista ativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите отдельные плейлисты для ТВ, фильмов и сериалов. Если источник заблокирован или недоступен, используется активный плейлист."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj separata spellistor för Live TV, filmer och serier. Om en källa är låst eller otillgänglig används den aktiva spellistan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเพลย์ลิสต์แยกสำหรับทีวีสด ภาพยนตร์ และซีรีส์ หากแหล่งที่มาถูกล็อกหรือใช้ไม่ได้ ระบบจะใช้เพลย์ลิสต์ที่ใช้งานอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn playlist riêng cho TV trực tiếp, phim và phim bộ. Nếu nguồn bị khóa hoặc không khả dụng, playlist đang hoạt động sẽ được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为直播电视、电影和剧集分别选择播放列表。若来源已锁定或不可用，则使用当前播放列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為直播電視、電影和影集分別選擇播放清單。若來源已鎖定或無法使用，則使用目前的播放清單。"
          }
        }
      }
    },
