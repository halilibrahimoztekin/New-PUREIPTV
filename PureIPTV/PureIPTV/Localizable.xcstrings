          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 성공 횟수와의 순증감입니다. 개별 추가 및 삭제 항목은 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
