    "VLC ekran ölçütü sağlayamıyor. Uygun VOD için Oynatıcı menüsünden AVPlayer'ı seçin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفر VLC معايير عرض. اختر AVPlayer من قائمة المشغل لمحتوى VOD المدعوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC liefert keine Anzeigekriterien. Wähle für unterstützte VOD-Inhalte im Player-Menü AVPlayer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC can’t provide display criteria. Choose AVPlayer in the player menu for supported VOD."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC no proporciona criterios. Elige AVPlayer en el menú para VOD compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC ne fournit pas de critères. Choisissez AVPlayer dans le menu pour une VOD compatible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC डिस्प्ले मानदंड नहीं दे सकता। समर्थित VOD के लिए प्लेयर मेनू में AVPlayer चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC tidak dapat memberikan kriteria layar. Pilih AVPlayer di menu untuk VOD yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC non fornisce criteri di visualizzazione. Scegli AVPlayer dal menu per i VOD supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLCは画面条件を提供できません。対応VODではプレーヤーメニューからAVPlayerを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC는 화면 기준을 제공할 수 없습니다. 지원되는 VOD에서는 메뉴에서 AVPlayer를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC kan geen schermcriteria leveren. Kies AVPlayer in het menu voor ondersteunde VOD."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VLC nie udostępnia kryteriów obrazu. Dla obsługiwanego VOD wybierz AVPlayer w menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VLC não fornece critérios. Escolha AVPlayer no menu para VOD compatível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VLC não fornece critérios. Escolha AVPlayer no menu para VOD compatível."
          }
        },
        "ru" : {
