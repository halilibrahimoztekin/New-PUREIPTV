        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elenco è salvato su questo dispositivo ed è indipendente dalle ricerche recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストはこのデバイスに保存され、最近の検索履歴とは別に管理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목록은 이 기기에 저장되며 최근 검색 기록과 별도로 관리됩니다."
