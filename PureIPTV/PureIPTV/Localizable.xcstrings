    "Bu kategori yalnızca seçili profil ve playlist için ana sayfada gösterilir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هذه الفئة على الصفحة الرئيسية لهذا الملف الشخصي وقائمة التشغيل فقط."
          }
        },
        "de" : {
          "stringUnit" : {
