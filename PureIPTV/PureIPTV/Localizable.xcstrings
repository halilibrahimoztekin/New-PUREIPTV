        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica a numeração dos episódios apenas neste dispositivo. Os dados do fornecedor podem estar incorretos; os dispositivos não são comparados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет нумерацию эпизодов только на этом устройстве. Данные провайдера могут быть неточными; устройства не сравниваются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar endast avsnittsnumreringen på den här enheten. Leverantörens data kan vara felaktiga; enheter jämförs inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบเลขตอนบนอุปกรณ์นี้เท่านั้น ข้อมูลจากผู้ให้บริการอาจไม่ถูกต้อง และไม่มีการเปรียบเทียบอุปกรณ์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ kiểm tra số tập trên thiết bị này. Dữ liệu nhà cung cấp có thể không chính xác; các thiết bị không được so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅检查此设备收到的剧集编号。提供方数据可能不准确；不会比较不同设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅檢查此裝置收到的劇集編號。供應商資料可能不準確；不會比較不同裝置。"
          }
        }
      }
    },
    "Yalnızca Canlı TV gezinmesi" : {

