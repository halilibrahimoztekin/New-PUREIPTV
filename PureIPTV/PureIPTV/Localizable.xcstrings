    "Odaktaki kart ve düğmelerin çevresinde belirgin beyaz ve koyu bir çerçeve gösterir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إطارًا أبيض داكنًا وواضحًا حول البطاقات والأزرار المحددة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen gut sichtbaren weißen und dunklen Rahmen um fokussierte Karten und Schaltflächen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a prominent white and dark outline around focused cards and buttons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un contorno blanco y oscuro bien visible alrededor de las tarjetas y los botones enfocados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un contour blanc et sombre bien visible autour des cartes et des boutons sélectionnés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित कार्ड और बटनों के चारों ओर स्पष्ट सफ़ेद और गहरा फ़्रेम दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan bingkai putih dan gelap yang jelas di sekeliling kartu dan tombol yang sedang difokuskan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un bordo bianco e scuro ben visibile attorno alle schede e ai pulsanti selezionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス中のカードやボタンの周囲に、見やすい白と黒の枠を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점이 맞춰진 카드와 버튼 주위에 눈에 잘 띄는 흰색 및 어두운 테두리를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een duidelijke witte en donkere rand rond gefocuste kaarten en knoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla wyraźną białą i ciemną ramkę wokół kart i przycisków, na których ustawiono fokus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe um contorno branco e escuro bem visível ao redor dos cartões e botões em foco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um contorno branco e escuro bem visível à volta dos cartões e botões em foco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает заметную белую и тёмную рамку вокруг карточек и кнопок в фокусе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en tydlig vit och mörk ram runt kort och knappar som har fokus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงกรอบสีขาวและสีเข้มที่มองเห็นชัดรอบการ์ดและปุ่มที่โฟกัสอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaktaki kart ve düğmelerin çevresinde belirgin beyaz ve koyu bir çerçeve gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує помітну білу й темну рамку навколо карток і кнопок у фокусі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị viền trắng và tối rõ nét quanh thẻ và nút đang được lấy nét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在获得焦点的卡片和按钮周围显示醒目的白色和深色边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在取得焦點的卡片和按鈕周圍顯示醒目的白色和深色外框。"
          }
        }
      }
    },
