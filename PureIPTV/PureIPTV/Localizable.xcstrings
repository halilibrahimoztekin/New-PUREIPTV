    "Bazı tamamlanmış indirmeler silinemedi. Depolama alanını kontrol edip yeniden deneyin." : {
      "comment" : "Downloads bulk-clear control text.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حذف بعض التنزيلات المكتملة. تحقق من مساحة التخزين وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige abgeschlossene Downloads konnten nicht gelöscht werden. Überprüfe den Speicher und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some completed downloads could not be removed. Check storage and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron eliminar algunas descargas completadas. Comprueba el almacenamiento e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains téléchargements terminés n’ont pas pu être supprimés. Vérifiez le stockage et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ पूरे किए गए डाउनलोड नहीं हटाए जा सके। स्टोरेज जाँचें और फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa unduhan selesai tidak dapat dihapus. Periksa penyimpanan lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile rimuovere alcuni download completati. Controlla lo spazio di archiviazione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の完了したダウンロードを削除できませんでした。ストレージを確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 완료된 다운로드를 삭제할 수 없습니다. 저장 공간을 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige voltooide downloads konden niet worden verwijderd. Controleer de opslag en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć niektórych ukończonych pobrań. Sprawdź miejsce i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover alguns downloads concluídos. Verifique o armazenamento e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover algumas transferências concluídas. Verifique o armazenamento e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить некоторые завершённые загрузки. Проверьте хранилище и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att ta bort vissa slutförda hämtningar. Kontrollera lagringsutrymmet och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบรายการดาวน์โหลดที่เสร็จแล้วบางรายการไม่ได้ โปรดตรวจสอบพื้นที่จัดเก็บแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı tamamlanmış indirmeler silinemedi. Depolama alanını kontrol edip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xóa một số nội dung đã tải xuống hoàn tất. Hãy kiểm tra dung lượng lưu trữ và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法删除部分已完成的下载。请检查存储空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法刪除部分已完成的下載。請檢查儲存空間後再試。"
          }
        }
      }
    },
