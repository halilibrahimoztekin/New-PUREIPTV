    "Bu liste bu cihazda saklanır ve son arama geçmişinden bağımsızdır." : {
      "comment" : "Explains that pinned searches are stored on this device and are independent of recent history.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ هذه القائمة على هذا الجهاز وهي مستقلة عن سجل البحث الأخير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Liste wird auf diesem Gerät gespeichert und ist unabhängig vom Suchverlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This list is saved on this device and is separate from recent search history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista se guarda en este dispositivo y es independiente del historial reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste est enregistrée sur cet appareil et reste distincte de l’historique récent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सूची इस डिवाइस पर सहेजी जाती है और हाल की खोजों से अलग रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar ini disimpan di perangkat ini dan terpisah dari riwayat pencarian terbaru."
