        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en el Llavero de este dispositivo. No se sincroniza con iCloud. La validación solo empieza al tocar el botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
