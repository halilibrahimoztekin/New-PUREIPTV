    "Bu playlist ve profilin favori kanallarının sırasını belirler." : {
      "localizations" : {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط ترتيب القنوات المفضلة لهذا الملف الشخصي وقائمة التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Reihenfolge der Lieblingssender für dieses Profil und diese Playlist fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the favorite channel order for this profile and playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el orden de canales favoritos para este perfil y esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit l’ordre des chaînes favorites pour ce profil et cette liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल और प्लेलिस्ट के पसंदीदा चैनलों का क्रम सेट करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur urutan kanal favorit untuk profil dan playlist ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l’ordine dei canali preferiti per questo profilo e questa playlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールとプレイリストのお気に入りチャンネルの順序を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필과 플레이리스트의 즐겨찾기 채널 순서를 설정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de volgorde van favoriete kanalen in voor dit profiel en deze afspeellijst."
          }
