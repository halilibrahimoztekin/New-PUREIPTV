    "Yalnızca sürüm ve işletim sistemi bilgileri gösterilir; hiçbir yere otomatik gönderilmez." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض معلومات الإصدار ونظام التشغيل فقط؛ ولا يُرسل أي شيء تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Versions- und Betriebssysteminformationen angezeigt; nichts wird automatisch gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only version and operating system details are included; nothing is sent automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se incluyen la versión y el sistema operativo; no se envía nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules la version et les informations du système sont incluses ; rien n’est envoyé automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें केवल संस्करण और ऑपरेटिंग सिस्टम की जानकारी है; कुछ भी अपने आप नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya informasi versi dan sistem operasi yang disertakan; tidak ada yang dikirim otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include solo versione e sistema operativo; non viene inviato nulla automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンとOS情報のみを含み、自動送信は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 및 운영 체제 정보만 포함되며 자동으로 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat alleen versie- en besturingssysteeminformatie; er wordt niets automatisch verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawiera tylko wersję i system operacyjny; nic nie jest wysyłane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui apenas a versão e o sistema operacional; nada é enviado automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui apenas a versão e o sistema operativo; nada é enviado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержит только сведения о версии и ОС; ничего не отправляется автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast versions- och operativsystemsinformation visas; inget skickas automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเฉพาะข้อมูลเวอร์ชันและระบบปฏิบัติการ โดยไม่มีการส่งข้อมูลอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sürüm ve işletim sistemi bilgileri gösterilir; hiçbir yere otomatik gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bao gồm phiên bản và hệ điều hành; không có dữ liệu nào được tự động gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含版本和操作系统信息；不会自动发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅包含版本與作業系統資訊；不會自動傳送任何內容。"
          }
        }
      }
    },
    "Rapor önizlemesi açılamadı." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح معاينة التقرير."
          }
        },
        "de": {
          "stringUnit": {
