    "Yalnızca oynatıcı kontrolleri gizliyken yön hareketlerine atanır. Aynı eylemi birden fazla yöne atayabilirsiniz." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تعيينها لحركات الاتجاه فقط عند إخفاء عناصر تحكم المشغل. يمكنك تعيين الإجراء نفسه لأكثر من اتجاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtungsbewegungen werden nur zugewiesen, wenn die Playersteuerung ausgeblendet ist. Dieselbe Aktion kann mehreren Richtungen zugewiesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directional movements are assigned only while player controls are hidden. You can assign the same action to multiple directions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los movimientos direccionales se asignan solo cuando los controles del reproductor están ocultos. Puedes asignar la misma acción a varias direcciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mouvements directionnels sont attribués uniquement lorsque les commandes du lecteur sont masquées. Vous pouvez attribuer la même action à plusieurs directions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिशात्मक गति केवल तब असाइन होती है जब प्लेयर नियंत्रण छिपे हों। आप एक ही कार्रवाई को कई दिशाओं में असाइन कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakan arah ditetapkan hanya saat kontrol pemutar tersembunyi. Anda dapat menetapkan tindakan yang sama ke beberapa arah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I movimenti direzionali vengono assegnati solo quando i controlli del lettore sono nascosti. Puoi assegnare la stessa azione a più direzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーコントロールが非表示のときだけ方向操作が割り当てられます。同じアクションを複数の方向に割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어 컨트롤이 숨겨져 있을 때만 방향 동작이 할당됩니다. 같은 동작을 여러 방향에 할당할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtingsbewegingen worden alleen toegewezen wanneer de spelerbediening verborgen is. Je kunt dezelfde actie aan meerdere richtingen toewijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruchy kierunkowe są przypisywane tylko wtedy, gdy elementy sterujące odtwarzaczem są ukryte. To samo działanie można przypisać do wielu kierunków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os movimentos direcionais são atribuídos somente quando os controles do player estão ocultos. Você pode atribuir a mesma ação a várias direções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os movimentos direcionais só são atribuídos quando os controlos do leitor estão ocultos. Pode atribuir a mesma ação a várias direções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия по направлениям назначаются, только когда элементы управления плеером скрыты. Одно действие можно назначить нескольким направлениям."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riktningsrörelser tilldelas endast när spelarreglagen är dolda. Du kan tilldela samma åtgärd till flera riktningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดการเคลื่อนไหวตามทิศทางเฉพาะเมื่อซ่อนตัวควบคุมเครื่องเล่น คุณสามารถกำหนดการกระทำเดียวกันให้หลายทิศทางได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển động theo hướng chỉ được gán khi ẩn điều khiển trình phát. Bạn có thể gán cùng một hành động cho nhiều hướng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在播放器控件隐藏时响应方向操作。你可以将同一操作分配给多个方向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在播放器控制項隱藏時回應方向操作。你可以將相同操作指派給多個方向。"
          }
        }
      }
    },
    "Yalnızca sürüm ve işletim sistemi bilgileri gösterilir; hiçbir yere otomatik gönderilmez." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض معلومات الإصدار ونظام التشغيل فقط؛ ولا يُرسل أي شيء تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Versions- und Betriebssysteminformationen angezeigt; nichts wird automatisch gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only version and operating system details are included; nothing is sent automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se incluyen la versión y el sistema operativo; no se envía nada automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules la version et les informations du système sont incluses ; rien n’est envoyé automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें केवल संस्करण और ऑपरेटिंग सिस्टम की जानकारी है; कुछ भी अपने आप नहीं भेजा जाता।"
