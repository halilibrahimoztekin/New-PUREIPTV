    "XMLTV kaynağı bozuk, izin verilen boyutu aşıyor veya desteklenmeyen bir arşiv biçiminde." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصدر XMLTV تالف أو يتجاوز الحجم المسموح أو يستخدم تنسيق أرشيف غير مدعوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die XMLTV-Quelle ist fehlerhaft, überschreitet die zulässige Größe oder verwendet ein nicht unterstütztes Archivformat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The XMLTV source is invalid, exceeds the allowed size, or uses an unsupported archive format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente XMLTV no es válida, supera el tamaño permitido o usa un formato de archivo no compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source XMLTV est invalide, dépasse la taille autorisée ou utilise un format d’archive non pris en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV स्रोत अमान्य है, अनुमत आकार से बड़ा है या असमर्थित संग्रह प्रारूप का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
