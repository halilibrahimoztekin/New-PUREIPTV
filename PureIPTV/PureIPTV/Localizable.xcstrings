    "Profil, tüm VLC oynatımları için uygulama genelinde geçerlidir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق الملف على جميع عمليات تشغيل VLC في التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil gilt appweit für alle VLC-Wiedergaben."
          }
