          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इस डिवाइस के Keychain में सहेजी जाती है। iCloud के साथ सिंक नहीं होती। सत्यापन केवल बटन दबाने पर शुरू होता है।"
