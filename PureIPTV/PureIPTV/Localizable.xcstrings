    "Bellek uyarısı nedeniyle Deinterlace kapatılamadı." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر إيقاف إزالة التشابك بسبب تحذير الذاكرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlacing konnte wegen einer Speicherwarnung nicht ausgeschaltet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not turn off deinterlacing after a memory warning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo desactivar el desentrelazado tras una advertencia de memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de désactiver le désentrelacement après une alerte mémoire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेमोरी चेतावनी के बाद डीइंटरलेसिंग बंद नहीं की जा सकी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlace tidak dapat dimatikan setelah peringatan memori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile disattivare il deinterlacciamento dopo un avviso di memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ警告後にデインターレースをオフにできませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 경고 후 디인터레이스를 끄지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De-interlacing kon na een geheugenwaarschuwing niet worden uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wyłączyć usuwania przeplotu po ostrzeżeniu o pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desativar o desentrelaçamento após um aviso de memória."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desativar o desentrelaçamento após um aviso de memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отключить деинтерлейсинг после предупреждения о нехватке памяти."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att stänga av deinterlacing efter en minnesvarning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดการแยกภาพอินเทอร์เลซหลังการแจ้งเตือนหน่วยความจำไม่สำเร็จ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося вимкнути деінтерлейсинг після попередження про пам’ять."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tắt khử xen kẽ sau cảnh báo bộ nhớ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存警告后无法关闭去隔行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶體警告後無法關閉反交錯。"
          }
        }
      }
    },
    "Bellek uyarısı nedeniyle Deinterlace kapatıldı. Tercihin sonraki oynatımda geri yüklenir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف إزالة التشابك بسبب تحذير الذاكرة. ستتم استعادة تفضيلك عند التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlacing wurde wegen einer Speicherwarnung ausgeschaltet. Deine Einstellung wird bei der nächsten Wiedergabe wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlacing was turned off due to a memory warning. Your preference will be restored on the next playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactivó el desentrelazado por una advertencia de memoria. Tu preferencia se restaurará en la próxima reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le désentrelacement a été désactivé en raison d’une alerte mémoire. Votre préférence sera rétablie à la prochaine lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेमोरी चेतावनी के कारण डीइंटरलेसिंग बंद कर दी गई। अगली बार चलाने पर आपकी पसंद बहाल हो जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlace dimatikan karena peringatan memori. Preferensi Anda akan dipulihkan pada pemutaran berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il deinterlacciamento è stato disattivato a causa di un avviso di memoria. La tua preferenza verrà ripristinata alla prossima riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ警告のため、デインターレースをオフにしました。次回の再生時に設定が復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 경고로 디인터레이스를 껐습니다. 다음 재생 때 설정이 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De-interlacing is uitgeschakeld vanwege een geheugenwaarschuwing. Je voorkeur wordt bij de volgende weergave hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwanie przeplotu wyłączono z powodu ostrzeżenia o pamięci. Twoje ustawienie zostanie przywrócone przy następnym odtwarzaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desentrelaçamento foi desativado devido a um aviso de memória. Sua preferência será restaurada na próxima reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desentrelaçamento foi desativado devido a um aviso de memória. A sua preferência será restaurada na próxima reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деинтерлейсинг отключён из-за предупреждения о нехватке памяти. Ваши настройки восстановятся при следующем воспроизведении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinterlacing stängdes av på grund av en minnesvarning. Inställningen återställs vid nästa uppspelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดการแยกภาพอินเทอร์เลซเนื่องจากมีคำเตือนหน่วยความจำ การตั้งค่าของคุณจะคืนค่าเมื่อเล่นครั้งถัดไป"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деінтерлейсинг вимкнено через попередження про пам’ять. Ваші налаштування буде відновлено під час наступного відтворення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tắt khử xen kẽ do cảnh báo bộ nhớ. Tùy chọn của bạn sẽ được khôi phục ở lần phát tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于内存警告，已关闭去隔行。下次播放时会恢复你的偏好设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因記憶體警告，已關閉反交錯。下次播放時會還原你的偏好設定。"
          }
        }
      }
    },
