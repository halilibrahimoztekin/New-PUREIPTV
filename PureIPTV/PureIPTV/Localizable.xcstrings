    "Kaynak güncellenemedi; mevcut veriler korundu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحديث المصدر؛ تم الاحتفاظ بالبيانات الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle konnte nicht aktualisiert werden; vorhandene Daten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not update source; existing data was preserved."
          }
        },
