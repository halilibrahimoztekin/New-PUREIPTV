    "EPG görseli bulunmadığında kanal logosu kullanılır. Playlist’e özel logo her zaman önceliklidir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند عدم توفر صورة برنامج دليل البرامج، يُستخدم شعار القناة. تظل الشعارات المخصصة لقائمة التشغيل لها الأولوية دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn kein EPG-Programmbild verfügbar ist, wird das Senderlogo verwendet. Playlist-spezifische Logoüberschreibungen haben immer Vorrang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When EPG artwork is unavailable, the channel logo is used. Playlist-specific logo overrides always take priority."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay una imagen del programa EPG, se usa el logotipo del canal. Los logotipos personalizados de la lista siempre tienen prioridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’image du programme EPG est indisponible, le logo de la chaîne est utilisé. Les logos personnalisés de la playlist restent prioritaires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPG छवि उपलब्ध न होने पर चैनल का लोगो दिखाया जाता है। प्लेलिस्ट के लिए निर्धारित लोगो को हमेशा प्राथमिकता दी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika gambar EPG tidak tersedia, logo saluran akan digunakan. Logo khusus playlist selalu diutamakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’immagine del programma EPG non è disponibile, viene usato il logo del canale. I loghi personalizzati della playlist hanno sempre la priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPG画像がない場合はチャンネルロゴを使用します。プレイリスト固有のロゴが常に優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPG 이미지가 없으면 채널 로고를 사용합니다. 재생목록별 로고가 항상 우선 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als er geen EPG-afbeelding beschikbaar is, wordt het kanaallogo gebruikt. Aangepaste logo’s per playlist hebben altijd voorrang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy obraz EPG jest niedostępny, wyświetlane jest logo kanału. Logo przypisane do playlisty ma zawsze pierwszeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a imagem do programa EPG não estiver disponível, o logo do canal será usado. Logos personalizados da playlist sempre têm prioridade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a imagem do programa EPG não estiver disponível, é usado o logótipo do canal. Os logótipos personalizados da playlist têm sempre prioridade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если изображение программы EPG недоступно, используется логотип канала. Логотипы, заданные для плейлиста, всегда имеют приоритет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om EPG-bilden saknas används kanalens logotyp. Spellistspecifika logotyper har alltid företräde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีภาพ EPG จะใช้โลโก้ช่อง โดยโลโก้ที่กำหนดไว้สำหรับเพลย์ลิสต์จะมีลำดับความสำคัญเสมอ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо зображення EPG недоступне, використовується логотип каналу. Логотипи, задані для плейлиста, завжди мають пріоритет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không có hình ảnh EPG, ứng dụng sẽ dùng logo kênh. Logo riêng của danh sách phát luôn được ưu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 EPG 图片时会使用频道徽标。播放列表专属徽标始终优先。"
