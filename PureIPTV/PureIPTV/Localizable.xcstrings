    "Anahtar doğrulanamadı. Anahtarı veya bağlantıyı kontrol edin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التحقق من المفتاح. تحقق من المفتاح أو الاتصال."
