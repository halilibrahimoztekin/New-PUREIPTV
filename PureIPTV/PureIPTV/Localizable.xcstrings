    "En fazla 10 arama sabitlenebilir. Yeni bir arama eklemek için önce birini kaldırın." : {
      "comment" : "Alert message shown when the pinned search list is full.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تثبيت 10 عمليات بحث كحد أقصى. أزل أحدها قبل إضافة بحث جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst bis zu 10 Suchen anheften. Entferne eine, bevor du eine weitere anheftest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pin up to 10 searches. Remove one before adding another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes fijar hasta 10 búsquedas. Quita una antes de añadir otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez épingler jusqu’à 10 recherches. Retirez-en une avant d’en ajouter une autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अधिकतम 10 खोजें पिन कर सकते हैं। नई खोज जोड़ने से पहले एक हटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menyematkan hingga 10 pencarian. Hapus satu sebelum menambahkan yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi fissare fino a 10 ricerche. Rimuovine una prima di aggiungerne un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索は最大10件までピン留めできます。新しい検索を追加する前に1件を削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색은 최대 10개까지 고정할 수 있습니다. 새 검색을 추가하기 전에 하나를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt maximaal 10 zoekopdrachten vastzetten. Verwijder er één voordat je een nieuwe toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przypiąć maksymalnie 10 wyszukiwań. Usuń jedno, zanim dodasz kolejne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode fixar até 10 buscas. Remova uma antes de adicionar outra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode afixar até 10 pesquisas. Remova uma antes de adicionar outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно закрепить не более 10 запросов. Удалите один, прежде чем добавить новый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fästa högst 10 sökningar. Ta bort en innan du lägger till en till."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปักหมุดได้สูงสุด 10 รายการ โปรดลบหนึ่งรายการก่อนเพิ่มรายการใหม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể ghim tối đa 10 mục tìm kiếm. Hãy xóa một mục trước khi thêm mục khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
