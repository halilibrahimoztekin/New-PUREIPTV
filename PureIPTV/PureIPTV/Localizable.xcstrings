    "Aramayı sabit listenize ekler veya listeden çıkarır." : {
      "comment" : "Accessibility hint for toggling the current query in the pinned list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف البحث إلى القائمة المثبتة أو يزيله منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt die Suche zur Liste hinzu oder entfernt sie daraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds this query to your pinned list or removes it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade esta búsqueda a tu lista de fijadas o la quita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute cette recherche à la liste épinglée ou l’en retire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खोज को पिन की गई सूची में जोड़ता या हटाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan atau menghapus pencarian ini dari daftar sematan."
          }
        },
