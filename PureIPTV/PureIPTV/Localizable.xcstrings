    "Önceki başarılı sayımlara göre net toplam farkı. Tek tek eklenen veya kaldırılan içerikler gösterilmez." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صافي فرق الإجمالي مقارنة بآخر أعداد ناجحة. لا تُعرض العناصر المضافة أو المحذوفة بشكل فردي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoänderung gegenüber den letzten erfolgreichen Zählungen. Einzelne hinzugefügte oder entfernte Inhalte werden nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net total change from the previous successful counts. Individual additions and removals are not shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio neto total respecto a los últimos recuentos correctos. No se muestran los elementos añadidos o eliminados individualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart net par rapport aux derniers décomptes réussis. Les éléments ajoutés ou supprimés individuellement ne sont pas affichés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली सफल गणनाओं से कुल शुद्ध बदलाव। अलग-अलग जोड़ी या हटाई गई सामग्री नहीं दिखाई जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
