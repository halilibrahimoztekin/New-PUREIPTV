    "Seçimler etkin profil ve bu playlist için geçerlidir. Kapalı seçeneği yalnız otomatik yenilemeyi durdurur." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الاختيارات على الملف الشخصي النشط وقائمة التشغيل هذه. يؤدي خيار الإيقاف إلى تعطيل التحديث التلقائي فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl gilt für das aktive Profil und diese Playlist. Aus deaktiviert nur die automatische Aktualisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These choices apply to the active profile and this playlist. Off only disables automatic refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opciones se aplican al perfil activo y a esta playlist. Desactivado solo detiene la actualización automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces choix s’appliquent au profil actif et à cette playlist. Désactivé arrête uniquement l’actualisation automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये विकल्प सक्रिय प्रोफ़ाइल और इस प्लेलिस्ट पर लागू होते हैं। बंद करने से केवल स्वचालित रीफ़्रेश रुकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilihan ini berlaku untuk profil aktif dan playlist ini. Nonaktif hanya menghentikan penyegaran otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste scelte si applicano al profilo attivo e a questa playlist. Disattivato interrompe solo l’aggiornamento automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択内容は現在のプロフィールとこのプレイリストに適用されます。「オフ」にすると自動更新のみ停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 선택 항목은 현재 프로필과 이 플레이리스트에 적용됩니다. 끔은 자동 새로 고침만 중지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze keuzes gelden voor het actieve profiel en deze playlist. Uit schakelt alleen automatisch vernieuwen uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia dotyczą aktywnego profilu i tej playlisty. Wył. wyłącza tylko automatyczne odświeżanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opções se aplicam ao perfil ativo e a esta playlist. Desativado interrompe apenas a atualização automática."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opções aplicam-se ao perfil ativo e a esta playlist. Desativado interrompe apenas a atualização automática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки применяются к активному профилю и этому плейлисту. Отключение останавливает только автообновление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valen gäller den aktiva profilen och den här spellistan. Av stänger bara av automatisk uppdatering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวเลือกเหล่านี้ใช้กับโปรไฟล์ที่ใช้งานอยู่และเพลย์ลิสต์นี้ ปิดจะหยุดเฉพาะการรีเฟรชอัตโนมัติเท่านั้น"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці налаштування діють для активного профілю та цього плейлиста. Вимкнення зупиняє лише автоматичне оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lựa chọn này áp dụng cho hồ sơ đang hoạt động và playlist này. Tắt chỉ dừng làm mới tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选项适用于当前个人资料和此播放列表。关闭只会停止自动刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些選項適用於目前的個人檔案和此播放清單。關閉只會停止自動重新整理。"
          }
        }
      }
    },
