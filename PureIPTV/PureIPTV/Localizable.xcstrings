          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta lista jest zapisywana na tym urządzeniu i jest niezależna od ostatnich wyszukiwań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista fica salva neste dispositivo e é separada do histórico de buscas recentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
