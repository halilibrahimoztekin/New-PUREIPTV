        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du choix des sources alternatives, lire la première correspondance de la liste sans ouvrir la liste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक स्रोत चुनने पर सूची खोले बिना प्लेलिस्ट क्रम का पहला मेल चलाएँ।"
